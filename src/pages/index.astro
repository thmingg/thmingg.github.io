---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import TechBadge from "@/components/TechBadge.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, postsConfig.perIndex);

const projects = (await getCollection("projects"))
  .filter(p => p.data.featured === true)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const techStack = [
  "React",
  "Vue",
  "Next.js",
  "TypeScript",
  "Flutter",
  "Go",
  "Python",
  "GraphQL",
  "PostgreSQL",
  "Docker",
  "AWS",
  "GCP",
];

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    data-pagefind-body
    class="app-layout"
  >
    <section id="hero" class="border-border hero-enter relative border-b bg-transparent pt-8 pb-8">
      <p class="text-foreground/70 text-sm tracking-wide uppercase">
        Hi, my name is
      </p>
      <h1 class="my-3 text-4xl font-bold sm:my-4 sm:text-5xl">
        {config.site.author}
      </h1>
      <p class="text-accent text-xl font-medium sm:text-2xl">
        Web-focused Software Engineer
      </p>
      <p class="mt-4 max-w-2xl">
        I build robust TypeScript applications—SPA and SSR frontends with React,
        Vue, and Next.js—paired with Flutter mobile apps and cloud backends on
        AWS and GCP.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
      <div class="mt-6">
        <LinkButton
          href="#contact"
          class="border-accent text-accent hover:bg-accent hover:text-accent-foreground motion-hover inline-flex border px-4 py-2 font-medium"
        >
          {t.home.contactCta}
        </LinkButton>
      </div>
      <a id="scroll-cue" href="#about" class="scroll-cue">
        <span>Scroll</span>
        <span class="scroll-cue__icon" aria-hidden="true"></span>
      </a>
    </section>

    <section id="about" class="border-border reveal border-b pt-12 pb-8">
      <h2 class="text-2xl font-semibold tracking-wide">{t.home.whoAmI}</h2>
      <p class="mt-4">
        Web-focused Software Engineer with over 3 years of hands-on experience
        building production TypeScript apps. Proven ability to modernize legacy
        frontends, ship JWT/OAuth auth, and collaborate across Agile teams.
      </p>
      <h3 class="mt-6 text-lg font-semibold">Education</h3>
      <ul class="mt-2 space-y-2">
        <li>
          <strong>BSc, Computer Science</strong> — Hong Kong Baptist University,
          2022–2024
        </li>
        <li>
          <strong>HD in Data Science and Analytics</strong> — IVE (Tsing Yi),
          2020–2022
        </li>
      </ul>
      <h3 class="mt-6 text-lg font-semibold">Tech stack</h3>
      <ul class="reveal-stagger mt-3 flex list-none flex-wrap gap-2 p-0">
        {
          techStack.map(tech => (
            <li>
              <TechBadge label={tech} size="md" />
            </li>
          ))
        }
      </ul>
      <div class="mt-6">
        <LinkButton
          href={getRelativeLocaleUrl(locale, "about")}
          class="motion-hover"
        >
          {t.home.viewAbout}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>

    <section id="projects" class="border-border reveal border-b pt-12 pb-8">
      <h2 class="text-2xl font-semibold tracking-wide">{t.home.projects}</h2>
      <p class="mt-2 text-foreground/80">
        Selected work from recent full-stack roles.
      </p>
      <ul class="reveal-stagger mt-6 grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-2">
        {
          projects.map(project => (
            <li class="h-full">
              <ProjectCard project={project} />
            </li>
          ))
        }
      </ul>
      <div class="mt-2">
        <LinkButton
          href={getRelativeLocaleUrl(locale, "projects")}
          class="motion-hover"
        >
          {t.home.viewAllProjects}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>

    {
      recentPosts.length > 0 && (
        <section id="blog" class="border-border reveal border-b pt-12 pb-8">
          <h2 class="text-2xl font-semibold tracking-wide">{t.home.blog}</h2>
          <p class="mt-2 text-foreground/80">
            Notes on what I’ve built and learned along the way.
          </p>
          <ul class="reveal-stagger">
            {recentPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
          <div class="mt-4">
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="motion-hover"
            >
              {t.home.allPosts}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    <section id="contact" class="reveal pt-12 pb-10">
      <h2 class="text-2xl font-semibold tracking-wide">{t.home.contact}</h2>
      <h3 class="mt-4 text-xl font-medium">Let’s build something together</h3>
      <p class="mt-3 max-w-2xl">
        I’m always open to collaboration, interesting product problems, and new
        challenges. If you’d like to connect, reach out by email or LinkedIn.
      </p>
      <div class="mt-6">
        <LinkButton
          href="mailto:danielhoming@gmail.com"
          class="border-accent text-accent hover:bg-accent hover:text-accent-foreground motion-hover inline-flex border px-4 py-2 font-medium"
        >
          {t.home.getInTouch}
        </LinkButton>
      </div>
      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
