---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const projects = (await getCollection("projects")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<Layout
  title={`${t.pages.projectsTitle} | ${config.site.title}`}
  description={t.pages.projectsDesc}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.projectsTitle} pageDesc={t.pages.projectsDesc}>
    <ul
      class="reveal-stagger mt-6 grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-2"
      data-pagefind-body
    >
      {
        projects.map(project => (
          <li class="h-full">
            <ProjectCard project={project} variant="h2" />
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
